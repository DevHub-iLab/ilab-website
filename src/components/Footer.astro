---
// Site footer, shown on every page.
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer>
  <div class="container inner">
    <p class="quip">Built by students, powered by curiosity.</p>
    <p class="fine">© {year} {site.fullName}</p>
  </div>
</footer>

<style>
  footer {
    background: var(--bg-deep); /* a step darker than the page */
    border-top: 1px solid var(--line);
    color: var(--ink-mid);
  }

  .inner {
    padding-block: 3rem;
    text-align: center;
    display: grid;
    gap: 0.75rem;
    justify-items: center;
  }

  .quip {
    font-size: 0.95rem;
  }

  .fine {
    font-size: 0.8rem;
    color: var(--ink-soft);
    margin-top: 0.75rem;
  }
</style>
