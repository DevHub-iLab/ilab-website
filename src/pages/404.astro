---
// The witty 404 page. Netlify/Vercel/GitHub Pages all serve this automatically.
import BaseLayout from '../layouts/BaseLayout.astro';
import { base } from '../utils.js';
---

<BaseLayout title="404 — Page not found">
  <section>
    <div class="container wrap">
      <p class="code">404</p>
      <h1>This page returned <span class="null">null</span>.</h1>
      <p class="lede">
        We checked twice. Even added a <code>console.log</code>. It's really not here.
      </p>
      <a class="btn btn-cta" href={`${base}/`}>Return home (guaranteed 200)</a>
    </div>
  </section>
</BaseLayout>

<style>
  .wrap {
    text-align: center;
    padding-block: 4rem;
  }

  .code {
    font-size: clamp(5rem, 18vw, 9rem);
    font-weight: 700;
    line-height: 1;
    /* gradient number, because plain black would be a missed opportunity */
    background: linear-gradient(135deg, var(--brand), var(--pop));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .null {
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .lede {
    margin: 1rem 0 2rem;
  }

  code {
    background: var(--bg-soft);
    padding: 0.1rem 0.4rem;
    border-radius: 0.4rem;
    font-size: 0.9em;
  }
</style>
