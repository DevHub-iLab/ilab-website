---
// The whole site lives on this one page: Hero → Pillars → About → Contact.
// The nav links jump to the section ids (#pillars, #about, #contact).
import BaseLayout from '../layouts/BaseLayout.astro';
import PillarBento from '../components/PillarBento.astro';
import CommitteeGrid from '../components/CommitteeGrid.astro';
import EventTimeline from '../components/EventTimeline.astro';
import HeroTerminal from '../components/HeroTerminal.astro';
import { site } from '../data/site';
import { base } from '../utils.js';
import ilab from '../icons/favicon.svg?raw';
---

<BaseLayout title="Home">
  <!-- Hero -->
  <section class="hero" id="home">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="hero-logo" set:html={ilab} />
        <h1>{site.tagline}</h1>
        <p class="lede">{site.intro}</p>
        <div class="hero-actions">
          <a class="btn btn-cta" href="#contact">Join Us</a>
          <a class="btn btn-secondary" href="#pillars">What we do</a>
        </div>
      </div>
      <HeroTerminal />
    </div>
  </section>

  <!-- Four pillars -->
  <section id="pillars">
    <div class="container">
      <p class="eyebrow">What we do</p>
      <h2>Our four pillars</h2>
      <PillarBento />
    </div>
  </section>

  <!-- About -->
  <section id="about" class="about">
    <div class="container about-grid">
      <div>
        <p class="eyebrow">About us</p>
        <h2>A lab, minus the safety goggles</h2>
        <p>
          The Innovation Lab is a student-run innovation lab at NTU's College of
          Computing and Data Science. [WIP]
        </p>
      </div>
      <img
        class="about-img"
        src={`${base}/images/about.svg`}
        alt="Innovation Lab members at work"
        width="800"
        height="600"
        loading="lazy"
      />
    </div>
  </section>

  <!-- Committee -->
  <section id="team">
    <div class="container">
      <p class="eyebrow">The committee</p>
      <h2>The humans in the lab</h2>
      <p class="section-intro">breakfast? lunch? dinner?</p>
      <div class="team-video">
        <video muted autoplay playsinline loop height="100" width="100">
          <source src={`${base}/videos/cats.mp4`} type="video/mp4" />
        </video>
      </div>
      <CommitteeGrid />
    </div>
  </section>

  <!-- Upcoming events -->
  <section id="events">
    <div class="container">
      <p class="eyebrow">What's on</p>
      <h2>Upcoming events</h2>
      <p class="section-intro">Probability of free food: high</p>
      <EventTimeline />
    </div>
  </section>

  <!-- Join / Contact -->
  <section id="contact">
    <div class="container narrow">
      <p class="eyebrow">Join / Contact</p>
      <h2>commit to something new</h2>
      <p class="section-intro">
        Open to all NTU CCDS students — no experience required, curiosity mandatory.
        Reach us on any of these channels and we'll take it from there.
      </p>
      <div class="channels">
        <a class="channel" href={`mailto:${site.email}`}>
          <h3>Email</h3>
          <p>{site.email}</p>
        </a>
        {
          site.socials.map((s) => (
            <a class="channel" href={s.url} target="_blank" rel="noopener noreferrer">
              <h3>{s.label}</h3>
              <p>{s.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* offset anchor jumps so the sticky top nav doesn't cover section headings */
  section {
    scroll-margin-top: 4rem;
  }

  /* in landscape the nav floats in the side margin — no offset needed,
     so anchors land exactly at the top of each section */
  @media (orientation: landscape) {
    section {
      scroll-margin-top: 0;
    }
  }

  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* fill the viewport (svh = ignores mobile browser chrome), minus the top nav strip */
    min-height: calc(100vh - 3.6rem);
    min-height: calc(100svh - 3.6rem);
    padding-block: 3rem 4.5rem;
    text-align: center;
    /* purple / cyan / coral glow behind the hero (the palette in src/data/site.js) */
    background:
      radial-gradient(60rem 30rem at 20% -10%, rgb(139 92 246 / 0.22), transparent),
      radial-gradient(50rem 25rem at 90% 0%, rgb(34 211 238 / 0.16), transparent),
      radial-gradient(35rem 18rem at 60% 90%, rgb(251 113 133 / 0.1), transparent);
  }

  .hero-logo {
    width: 180px;
    margin-bottom: 0;
  }

  @media (max-width: 36rem) {
    .hero-logo {
      display:none;
    }
  }

  .hero-grid {
    display: grid;
    align-items: center;
    gap: 3rem;
  }

  .lede {
    max-width: 40rem;
    margin: 1.25rem auto 2rem;
    font-size: 1.15rem;
  }

  .hero-actions {
    display: flex;
    justify-content: center; /* matches the centred portrait hero */
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* landscape: copy on the left, terminal on the right */
  @media (orientation: landscape) {
    .hero {
      /* the nav floats in the margin here, so take the full viewport */
      min-height: 100vh;
      min-height: 100svh;
      text-align: left;
    }

    .hero-grid {
      grid-template-columns: 1.1fr 1fr;
    }

    .lede {
      margin-inline: 0;
    }

    .hero-actions {
      justify-content: flex-start;
    }
  }


  /* these sections also fill the viewport, content centred vertically */
  #pillars,
  .about,
  #team,
  #events,
  #contact {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
  }

  .section-intro {
    margin: 0.5rem 0 2.5rem;
  }

  #team .container {
    position: relative;
  }

  .team-video {
    position: absolute;
    top: 0rem;
    left: min(25rem, 100% - 95px);
  }

  .team-video video {
    border-radius: 50%;
    box-shadow: 0 0 18px -4px color-mix(in srgb, #fff 55%, transparent);
    animation: spin 10s linear infinite;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  #pillars h2 {
    margin-bottom: 2rem; /* spacing the old intro line used to provide */
  }

  .narrow {
    max-width: 46rem;
  }

  /* alternate section backgrounds: dark → lifted → dark → lifted → dark */
  .about,
  #events {
    background: var(--bg-soft);
  }

  .about p {
    margin-bottom: 1.25rem;
  }

  .about-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  /* landscape: text left, photo right */
  @media (orientation: landscape) {
    .about-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .about-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: calc(var(--radius) * 1.5);
    border: 1px solid var(--line);
    rotate: -2deg; /* playful tilt; straightens on hover */
    transition: rotate 0.25s ease;
  }

  .about-img:hover {
    rotate: 0deg;
  }

  .channels {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 36rem) {
    .channels {
      grid-template-columns: 1fr;
    }
  }

  .channel {
    display: block;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .channel:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
    border-color: var(--pop);
  }

  .channel h3 {
    margin-bottom: 0.25rem;
  }

  .channel p {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
</style>
